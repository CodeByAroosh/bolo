// Prisma schema for Bolo
// SQLite for development, PostgreSQL-ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  name            String           @default("Learner")
  avatar          String?
  targetLanguage  String           @default("mr") // Default to Marathi
  xp              Int              @default(0)
  gems            Int              @default(50)
  hearts          Int              @default(5)
  heartsUpdatedAt DateTime         @default(now())
  currentStreak   Int              @default(0)
  longestStreak   Int              @default(0)
  lastStreakDate  String?          // YYYY-MM-DD
  streakFreezeActive Boolean       @default(false)
  league          String           @default("Bronze") // Bronze, Silver, Gold
  minutesSpoken   Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  unitProgress    UnitProgress[]
  lessonAttempts  LessonAttempt[]
  voiceSessions   VoiceSession[]
  srsItems        SRSItem[]
  pronunciationIssues PronunciationIssue[]
  grammarIssues   GrammarIssue[]
}

model UnitProgress {
  id          String   @id @default(cuid())
  userId      String
  language    String
  tierId      String
  unitId      String
  status      String   @default("locked") // locked, available, in_progress, completed
  score       Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language, unitId])
}

model LessonAttempt {
  id          String   @id @default(cuid())
  userId      String
  language    String
  unitId      String
  lessonType  String   // words, pattern, ears, muhavara, bolo, checkpoint
  score       Int
  accuracy    Float
  xpEarned    Int
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceSession {
  id          String      @id @default(cuid())
  userId      String
  unitId      String
  language    String
  turnsCount  Int         @default(0)
  overallScore Int        @default(0)
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns       VoiceTurn[]
}

model VoiceTurn {
  id              String       @id @default(cuid())
  sessionId       String
  questionId      String
  promptTarget    String
  promptEnglish   String
  verbatimHeard   String
  translitHeard   String?
  taskScore       Int          // 0-100
  clarityScore    Int          // 0-100
  accuracyScore   Int          // 0-100
  meaningOk       Boolean
  praise          String
  tutorReply      String
  nativeBetter    String
  createdAt       DateTime     @default(now())

  session         VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model PronunciationIssue {
  id          String   @id @default(cuid())
  userId      String
  language    String
  word        String
  heardAs     String
  issueType   String   // e.g. "retroflex l vs dental l (ळ vs ल)"
  tipEnglish  String
  confidence  String   // low, medium, high
  count       Int      @default(1)
  lastSeenAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language, word, issueType])
}

model GrammarIssue {
  id          String   @id @default(cuid())
  userId      String
  language    String
  said        String
  shouldBe    String
  whyEnglish  String
  count       Int      @default(1)
  lastSeenAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SRSItem {
  id          String   @id @default(cuid())
  userId      String
  language    String
  itemType    String   // word, pattern, idiom
  itemId      String
  target      String
  roman       String
  english     String
  interval    Int      @default(1) // days
  repetition  Int      @default(0)
  ease        Float    @default(2.5) // SM-2 ease factor
  dueAt       DateTime @default(now())
  lastReview  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language, itemId])
}
